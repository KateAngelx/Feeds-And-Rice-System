# Database
# For local development with PostgreSQL
DATABASE_URL="postgresql://user:password@localhost:5432/feedsandrice?schema=public"

# For Vercel PostgreSQL or Neon
# DATABASE_URL="postgresql://[user]:[password]@[host]:[port]/[database]?schema=public"

# For serverless functions (Vercel), use unpooled connection
DATABASE_URL_UNPOOLED="postgresql://user:password@localhost:5432/feedsandrice?schema=public"

# Node Environment
NODE_ENV="development"

